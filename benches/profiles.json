{
  "x86_64": [
    {
      "name": "{OS} x86-64-v1",
      "rustflags": ["-Ctarget-cpu=x86-64"]
    },
    {
      "name": "{OS} x86-64-v2",
      "requires": ["x86-64-v2"],
      "rustflags": ["-Ctarget-cpu=x86-64-v2"]
    },
    {
      "name": "{OS} x86-64-v3",
      "requires": ["x86-64-v3"],
      "rustflags": ["-Ctarget-cpu=x86-64-v3"]
    },
    {
      "name": "{OS} x86-64-v4",
      "requires": ["x86-64-v4"],
      "rustflags": ["-Ctarget-cpu=x86-64-v4", "-Ctarget-feature=-prefer-256-bit"]
    }
  ],
  "wasm32": [
    {
      "name": "WASM SIMD ({OS} {ARCH})",
      "rustflags": ["-Ctarget-feature=+simd128,-relaxed-simd"]
    },
    {
      "name": "WASM Relaxed SIMD ({OS} {ARCH})",
      "rustflags": ["-Ctarget-feature=+simd128,+relaxed-simd"]
    }
  ],
  "other": [
    {
      "name": "{OS} {ARCH}",
      "rustflags": []
    }
  ]
}
